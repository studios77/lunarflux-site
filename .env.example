# 문의 폼 전달 설정.
#
# Web3Forms · 이메일(ZeptoMail 또는 Resend) · 웹훅이 있고 전부 선택입니다. 하나만
# 설정해도 되고, 여럿 설정하면 모두로 전달됩니다. 아무것도 없으면 폼은 접수하지 않고
# "이메일로 보내주세요" 를 안내합니다 — 전달되지 않은 문의를 접수된 것처럼
# 보이게 하지 않기 위함입니다.
#
# 아래 값들은 브라우저에 노출되면 안 되는 비밀입니다.
# NEXT_PUBLIC_ 접두사를 붙이지 마세요.
#
# 운영 값은 로컬 파일이 아니라 Cloudflare 에 Secret 으로 등록합니다:
#   npx wrangler pages secret put <이름> --project-name lunarflux
#   또는 대시보드 → lunarflux → Settings → Environment variables
#
# 로컬 테스트는 .dev.vars 에 넣고 (gitignore 처리됨)
#   npm run build && npx wrangler pages dev out
# (`npm run dev` 는 Next 개발 서버라 /api/contact 를 서빙하지 않습니다.)

# ── 방법 0: Web3Forms (가장 빠름 — 도메인 인증·DKIM 불필요)
# https://web3forms.com → 대시보드에서 Access Key 복사.
# 받는 주소는 Web3Forms 계정에 등록된 주소라 CONTACT_TO_EMAIL 이 필요 없습니다.
# 키는 서버(Pages Function)에서만 씁니다. 브라우저에 노출하지 마세요 —
# 키를 아는 누구나 이 주소로 메일을 보낼 수 있어 스팸 표적이 됩니다.
WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── 받을 주소 (ZeptoMail·Resend 로 직접 발송할 때만 필요)
CONTACT_TO_EMAIL=contact@lunarflux.ai
# 발신 주소. 발송 서비스에서 인증한 도메인이어야 합니다.
CONTACT_FROM_EMAIL=LunarFlux AI <noreply@lunarflux.ai>

# ── 방법 1: ZeptoMail (Zoho 메일을 쓰는 경우 권장)
# https://www.zoho.com/zeptomail/ → Mail Agent 생성 → Send Mail Token 발급.
# 도메인이 이미 Zoho 에 붙어 있으면 인증 절차가 짧습니다.
# "Zoho-enczapikey ..." 를 통째로 넣어도 되고 뒤쪽 키만 넣어도 됩니다.
ZEPTOMAIL_TOKEN=Zoho-enczapikey xxxxxxxxxxxxxxxx
# 리전 엔드포인트. 기본값 api.zeptomail.com. EU 계정이면 api.zeptomail.eu
# ZEPTOMAIL_HOST=api.zeptomail.com

# ── 방법 2: Resend (대안)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── 방법 3: 웹훅 (선택, 이메일과 병행 가능)
# Slack · Discord · 범용 JSON 엔드포인트. URL 로 형식을 자동 판별합니다.
# ADMIN_NOTIFY_WEBHOOK=https://hooks.slack.com/services/XXX/YYY/ZZZ
